        <mxCell id="f_l0_o_in" value="&lt;div style='text-align:left; line-height:1.4;'&gt;&lt;b&gt;[Input Owner]&lt;/b&gt;&lt;br&gt;&amp;bull; Konfirmasi Kesiapan Kamar (SIAP_HUNI)&lt;br&gt;&amp;bull; Catatan Kunci &amp;amp; Kamar Kos&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;exitX=0;exitY=0.3;entryX=1;entryY=0.6;" edge="1" parent="1" source="ent_l0_owner" target="proc_0">
