        <!-- HEADER TITLE -->
        <mxCell id="hdr_l0" value="&lt;b style='font-size:16px;'&gt;DFD LEVEL 0 (DIAGRAM KONTEKS) &amp;mdash; ARCHOFESA KOST&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333333;'&gt;Sistem Informasi Pengelolaan &amp;amp; Reservasi Kost &amp;mdash; Batasan Sistem &amp;amp; Entitas Luar&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1400" height="55" as="geometry" />
        </mxCell>

        <!-- CENTRAL PROCESS 0.0 -->
        <mxCell id="proc_0" value="&lt;b style='font-size:15px;'&gt;0.0&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:13px;'&gt;SISTEM INFORMASI&lt;br&gt;PENGELOLAAN &amp;amp; RESERVASI KOST&lt;br&gt;(ARCHOFESA KOST)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#555555;'&gt;Aplikasi Web Terintegrasi&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="340" height="210" as="geometry" />
        </mxCell>

        <!-- EXTERNAL ENTITIES -->
        <mxCell id="ent_l0_cust" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='width:100%; border-collapse:collapse; font-size:11px; text-align:center; border:1px solid #000000;'&gt;&lt;tr style='background:#E5E5E5; font-weight:bold; font-size:12px;'&gt;&lt;td&gt;PENYEWA (CUSTOMER)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px; color:#333333;'&gt;Calon &amp;amp; Penghuni Kos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="240" height="75" as="geometry" />
