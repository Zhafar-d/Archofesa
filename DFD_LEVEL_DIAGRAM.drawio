        <mxCell id="f_l0_o_out" value="&lt;div style='text-align:left; line-height:1.4;'&gt;&lt;b&gt;[Output Owner]&lt;/b&gt;&lt;br&gt;&amp;bull; Notifikasi Booking Lunas Siap Huni&lt;br&gt;&amp;bull; Laporan Pendapatan Bersih&lt;br&gt;&amp;bull; Statistik Okupansi &amp;amp; Hunian&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="proc_0" target="ent_l0_owner">
