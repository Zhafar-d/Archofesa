        <mxCell id="f_l0_c_in" value="&lt;div style='text-align:left; line-height:1.4;'&gt;&lt;b&gt;[Input Customer]&lt;/b&gt;&lt;br&gt;&amp;bull; Registrasi/Login&lt;br&gt;&amp;bull; Pengajuan Booking &amp;amp; Tgl Masuk&lt;br&gt;&amp;bull; Update Profil &amp;amp; Telepon&lt;br&gt;&amp;bull; Pengajuan Perpanjangan Sewa&lt;br&gt;&amp;bull; Rating &amp;amp; Ulasan&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;exitX=1;exitY=0.3;entryX=0;entryY=0.2;" edge="1" parent="1" source="ent_l0_cust" target="proc_0">
