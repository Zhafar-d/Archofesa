        <mxCell id="ent_l0_admin" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='width:100%; border-collapse:collapse; font-size:11px; text-align:center; border:1px solid #000000;'&gt;&lt;tr style='background:#E5E5E5; font-weight:bold; font-size:12px;'&gt;&lt;td&gt;ADMINISTRATOR (ADMIN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px; color:#333333;'&gt;Pengelola Operasional Kos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;overflow=fill;" vertex="1" parent="1">
