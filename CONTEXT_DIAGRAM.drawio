          </mxGeometry>
        </mxCell>

        <!-- ========================================== -->
        <!-- DATA FLOWS: MIDTRANS <-> SYSTEM            -->
        <!-- ========================================== -->

        <!-- Flow M1: System -> Midtrans (Request Payment) -->
        <mxCell id="flow_m_in" value="&lt;div style='text-align:left; line-height:1.4;'&gt;&lt;b&gt;[Request Transaksi]&lt;/b&gt;&lt;br&gt;&amp;bull; Parameter Order ID &amp;amp; Gross Amount&lt;br&gt;&amp;bull; Customer Details &amp;amp; Item Info&lt;br&gt;&amp;bull; Request Snap Token API&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="proc_sys" target="ent_midtrans">
