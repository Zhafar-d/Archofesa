        <!-- ========================================== -->
        <!-- DATA FLOWS: GOOGLE AUTH <-> SYSTEM         -->
        <!-- ========================================== -->

        <!-- Flow G1: System -> Google (Auth Request) -->
        <mxCell id="flow_g_in" value="&lt;div style='text-align:left; line-height:1.4;'&gt;&lt;b&gt;[Request OAuth]&lt;/b&gt;&lt;br&gt;&amp;bull; Permintaan Redirect Autentikasi SSO&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" edge="1" parent="1" source="proc_sys" target="ent_auth">
          <mxGeometry relative="1" as="geometry">
